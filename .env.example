APP_NAME="Sistemas y Tableros · Plásticos Carmen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_TIMEZONE=America/La_Paz

LOG_CHANNEL=stack
LOG_LEVEL=warning

# SQLite por defecto: no hace falta instalar ningún servidor de base de datos.
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/database.sqlite

# Para el servidor de Plásticos Carmen, que ya tiene MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portafolio_v4
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Clave para entrar a /importar. Si queda vacía, la pantalla de carga
# queda abierta a cualquiera que tenga el enlace.
PORTAFOLIO_CLAVE_CARGA=
